---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Hero from '../components/top/Hero.astro';
import SkillTable from '../components/top/SkillTable.astro';
import PickupList from '../components/top/PickupList.astro';
import WorksTimeline from '../components/top/WorksTimeline.astro';
import InternshipList from '../components/top/InternshipList.astro';

const skills = [
  { category: 'Language',  items: ['TypeScript', 'Python'] },
  { category: 'Framework', items: ['Astro', 'React'] },
  { category: 'Tool',      items: ['Git'] },
];
---
<Layout ogDescription="ポートフォリオ">
  <main>
    <Hero />

    <section>
      <SectionTitle>About</SectionTitle>
      <p>法学部に通う2028年卒業予定の学生です。大学に入ってから独学でプログラミングを始め、TypeScript と React を中心に、ゲームなどを個人で作り続けています。完成したら友人に遊んでもらい、その感想を次の作品に活かすことを3年間続けてきました。そのうち1本は DLsite で販売しています。</p>
      <p>現在は就活支援サービスを運営する会社でフロントエンドのアルバイトをしながら、実際のコードベースで開発しています。今後は使う人の不便を出発点に、もっと多くの人に届くプロダクトを作りたいと考えています。</p>
      <SkillTable skills={skills} />
    </section>

    <section>
      <SectionTitle>Internship</SectionTitle>
      <InternshipList />
    </section>

    <section>
      <SectionTitle>Posts</SectionTitle>
      <PickupList />
    </section>

    <section>
      <SectionTitle>Works</SectionTitle>
      <WorksTimeline />
    </section>
  </main>

  <style>
    main {
      gap: 4rem;
      counter-reset: sec;
    }
  </style>
</Layout>
