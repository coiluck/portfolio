---
import Tag from '../Tag.astro';
import { getSortedPosts } from '../../utils/getWorks';
import { withBase } from '../../utils/path';

const posts = await getSortedPosts();
---
<ul class="pickup">
  {posts.map((post) => (
    <li>
      <a class="pickup-card" href={withBase(`/works/${post.id}/`)}>
        <div class="pickup-thumb">
          {post.data.thumbnailSrc && <img src={withBase(post.data.thumbnailSrc)} alt="" loading="lazy" />}
        </div>
        <div class="pickup-body">
          <div class="pickup-head">
            <span class="pickup-title">{post.data.title}</span>
            {post.data.tags.length > 0 && (
              <div class="pickup-tags">
                {post.data.tags.map((tag) => <Tag>{tag}</Tag>)}
              </div>
            )}
          </div>
          {post.data.description && <p class="pickup-description">{post.data.description}</p>}
          <span class="pickup-read">詳細を読む</span>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .pickup {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.2rem;
    list-style: none;
  }
  .pickup-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--text);
    text-decoration: none;
    backdrop-filter: blur(1px);
    background-color: rgb(from var(--bg-mild) r g b / .45);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 1.2rem), calc(100% - 1.2rem) 100%, 0 100%);
    transition: background-color .3s;
  }
  .pickup-thumb {
    aspect-ratio: 16 / 9;
    background: repeating-linear-gradient(-45deg, rgb(from var(--text) r g b / .06) 0 8px, transparent 8px 16px);
    border-bottom: 2px solid var(--accent);
    overflow: hidden;
  }
  .pickup-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale .4s;
  }
  .pickup-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: .4rem;
    padding: .8rem 1rem 1.2rem;
  }
  .pickup-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
  }
  .pickup-title {
    font-size: 1.15rem;
  }
  .pickup-description {
    font-size: .8rem;
    opacity: .75;
  }
  .pickup-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 5px;
  }
  .pickup-read {
    margin-top: auto;
    padding-top: .4rem;
    font-size: .8rem;
    color: var(--accent);
  }
  .pickup-read::after {
    content: ' →';
  }
  @media (hover: hover) {
    .pickup-card:hover {
      background-color: rgb(from var(--bg-mild) r g b / .75);
    }
    .pickup-card:hover .pickup-thumb img {
      scale: 1.08;
    }
  }
</style>
