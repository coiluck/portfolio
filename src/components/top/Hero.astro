---
import IconImage from '../IconImage.astro';
import LinkButton from '../LinkButton.astro';
import { withBase } from '../../utils/path';
---
<section class="hero">
  <div class="hero-icon">
    <IconImage imageSrc={withBase('/images/icon_base.avif')} hoverImageSrc={withBase('/images/icon_hover.avif')} />
  </div>
  <LinkButton href="https://github.com/coiluck" text="GitHub">
    <img class="github-icon" src={withBase('/images/github.svg')} alt="" />
  </LinkButton>
</section>

<style>
  .hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }
  @media (max-width: 768px) {
    .hero {
      align-items: center;
      flex-direction: column;
    }
  }

  .github-icon {
    width: 1.6em;
    height: 1.6em;
  }
</style>
