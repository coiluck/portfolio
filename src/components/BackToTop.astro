---
import { withBase } from '../utils/path';
---
<a class="back-to-top" href={withBase('/')}>
  <span class="arrow" aria-hidden="true">←</span>
  トップへ戻る
</a>

<style>
  .back-to-top {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    width: fit-content;
    padding: .5rem 1.9rem;
    color: var(--text);
    font-size: .9rem;
    letter-spacing: .05em;
    text-decoration: none;
    transition: color .3s;
  }
  .back-to-top::before,
  .back-to-top::after {
    content: '';
    position: absolute;
    inset: 0;
    transform: skewX(24deg);
  }
  .back-to-top::before {
    z-index: -1;
    border: 1px solid rgb(from var(--text) r g b / .8);
  }
  .back-to-top::after {
    z-index: -2;
    background-color: var(--accent);
    transform: skewX(24deg) scaleX(0);
    transform-origin: right;
    transition: transform .35s cubic-bezier(.2, .7, .2, 1);
  }
  .arrow {
    transition: translate .3s;
  }
  @media (hover: hover) {
    .back-to-top:hover {
      color: var(--text-dark);
    }
    .back-to-top:hover::after {
      transform: skewX(24deg) scaleX(1);
    }
    .back-to-top:hover .arrow {
      translate: -4px 0;
    }
  }
</style>
