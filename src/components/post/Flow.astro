---
interface Props {
  numbered?: boolean; // タイトルの前に連番をつける
}

const { numbered = false } = Astro.props;
---
<ol class:list={['flow', { numbered }]}>
  <slot />
</ol>

<style>
  .flow {
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    gap: 1.6rem;
    margin-bottom: 1.2rem;
    padding: 0;
    list-style: none;
    counter-reset: flow;
  }
  @media (max-width: 768px) {
    .flow {
      grid-auto-flow: row;
    }
  }
</style>
