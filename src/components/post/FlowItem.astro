---
interface Props {
  title: string;
  badge?: string;   // 小さなラベル
  current?: boolean; // 強調するか
}

const { title, badge, current = false } = Astro.props;
---
<li class:list={['flow-item', { current }]}>
  <span class="flow-title">{title}</span>
  {badge && <span class="flow-badge">{badge}</span>}
  <div class="flow-body"><slot /></div>
</li>

<style>
  .flow-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .4rem;
    padding: .8rem 1rem;
    background-color: rgb(from var(--bg-mild) r g b / .4);
    counter-increment: flow;
  }
  .flow-item.current {
    background-color: rgb(from var(--accent) r g b / .1);
  }

  .flow-item + .flow-item::before {
    content: '▶';
    position: absolute;
    top: 50%;
    left: -.8rem;
    translate: -50% -50%;
    color: var(--accent);
    font-size: .7rem;
  }
  @media (max-width: 768px) {
    .flow-item + .flow-item::before {
      top: -.8rem;
      left: 50%;
      rotate: 90deg;
    }
  }

  .flow-title {
    font-weight: bold;
  }
  :global(.numbered) > .flow-item .flow-title::before {
    content: counter(flow) '. ';
    color: var(--accent);
  }
  .flow-badge {
    padding: 0 .5rem;
    font-size: .75rem;
    border: 1px solid var(--accent);
  }
  .flow-body {
    font-size: .85rem;
    line-height: 1.6;
  }
  .flow-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
